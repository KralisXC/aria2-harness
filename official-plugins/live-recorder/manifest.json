{
  "id": "com.harness.live-recorder",
  "name": "直播流录制",
  "version": "1.1.3",
  "description": "支持录制 RTMP/RTSP 等在线直播流，自动保存为本地视频文件，随时停止。",
  "author": "Aria2-Harness",
  "apiVersion": "1.1",
  "entry": "main.js",
  "engine": "js",
  "priority": 100,
  "hooks": ["onTaskDetected", "onTaskRun", "onTaskCancel"],
  "permissions": ["exec:ffmpeg", "notify"],
  "routing": [
    { "pattern": "rtmp://*", "priority": 20, "handler": "onTaskDetected" },
    { "pattern": "rtsp://*", "priority": 20, "handler": "onTaskDetected" },
    { "pattern": "*.flv", "priority": 30, "handler": "onTaskDetected" },
    { "pattern": "*live.bilibili.com*", "priority": 5, "handler": "onTaskDetected" },
    { "pattern": "*bilivideo.cn*", "priority": 5, "handler": "onTaskDetected" }
  ],
  "settings_schema": [
    {
      "key": "custom_live_patterns",
      "label": "自定义直播流识别特征（每行一个，命中即接管，如 .flv 或 rtmp://）",
      "type": "textarea",
      "default": ""
    },
    {
      "key": "custom_ffmpeg_args",
      "label": "高级：额外的 FFmpeg 录制参数（默认 -c copy）",
      "type": "string",
      "default": "-c copy"
    }
  ],
  "limits": {
    "timeoutMs": 5000,
    "taskTimeoutMs": 1800000,
    "memoryMb": 64
  },
  "integrity": {
    "algorithm": "sha256",
    "files": {
      "main.js": "46cf766b380d4d4232e0946548d2680dd186a075cd381f39375a320d5a8292b3"
    }
  }
}
